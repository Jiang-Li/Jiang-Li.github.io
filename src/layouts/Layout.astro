---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;

const navLinks = [
  { text: 'Home', href: '/index.html' },
  { text: 'FAQ', href: '/program.html' },
  { text: 'Courses', href: '/course.html' },
  { text: 'Research', href: '/publication.html' },
  { text: 'Posts', href: '/post.html' },
  { text: 'Teaching', href: '/teach.html' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Program Chair for Analytics Programs at Franklin University | Data Science Educator | Former Industry Data Scientist"
    />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z48603M6WF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-Z48603M6WF');
    </script>
    <!-- Pagefind search UI assets (generated at build time into /pagefind/) -->
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </head>
  <body>
    <header class="site-navbar">
      <nav class="navbar-inner">
        <button class="nav-toggle" aria-label="Toggle navigation" onclick="document.getElementById('navMenu').classList.toggle('open')">☰</button>
        <div class="nav-links" id="navMenu">
          {
            navLinks.map((l) => (
              <a href={l.href} class="nav-link">
                {l.text}
              </a>
            ))
          }
        </div>
        <div class="nav-right">
          <button class="nav-icon-btn" aria-label="Search" onclick="document.getElementById('searchPanel').classList.toggle('open');document.querySelector('#searchPanel input')?.focus()">🔍</button>
          <a class="nav-icon-btn" aria-label="LinkedIn" href="https://www.linkedin.com/in/jiang-li-analytics/">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
          <a class="nav-icon-btn" aria-label="Email" href="mailto:jiang.li2@franklin.edu">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
        </div>
      </nav>
      <div class="search-panel" id="searchPanel">
        <pagefind-search id="search" style="--pagefind-ui-scale: 0.9;"></pagefind-search>
      </div>
    </header>

    <main class="page-main">
      <slot />
    </main>

    <footer class="page-footer">
      <div class="footer-inner">
        <div class="footer-col">Dr. Jiang Li | Franklin University</div>
        <div class="footer-col footer-center">
          <a href="mailto:jiang.li2@franklin.edu">📧 jiang.li2@franklin.edu</a>
          |
          <a href="https://outlook.office.com/bookwithme/user/1b87d6117e28448bbaa0cb30b44c1f47@franklin.edu?anonymous&ep=bwmEmailSignature">📅 Book Meeting</a>
        </div>
        <div class="footer-col footer-right">© 2026 | Powered by <a href="https://astro.build">Astro</a></div>
      </div>
    </footer>

    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <script is:inline>
      // Global helper used by tutorial pages (moved from inline page script)
      function toggleSolution(id) {
        var x = document.getElementById(id);
        if (x.style.display === 'none') {
          x.style.display = 'block';
        } else {
          x.style.display = 'none';
        }
      }
    </script>
  </body>
</html>
