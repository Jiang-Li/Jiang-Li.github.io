---
import '../styles/global.css';

interface Props {
  title: string;
  subtitle?: string;
  /**
   * 'guide' swaps the single centred column for the docs shell used by the four
   * /teach/ guides: a sticky left nav plus a narrower content column, with
   * `sidebar`, `content-top` and `content-bottom` slots. Anything else — i.e.
   * every other page — renders exactly the markup it rendered before this prop
   * existed. Set by GuideLayout.astro, never from page frontmatter.
   */
  variant?: 'guide';
  /**
   * Optional in-page section nav for long single-column pages (Programs,
   * Careers). Set from MDX frontmatter as a list of `{ id, text }`; the ids
   * must exist on the page. The four /teach/ guides use the sidebar instead
   * and should not set this.
   */
  sections?: { id: string; text: string }[];
  /** Page-specific meta description. Falls back to the site default. */
  description?: string;
  /** Page-specific share image, relative to the site root. */
  ogImage?: string;
  /** 'programs' additionally emits EducationalOccupationalProgram schema. */
  schemaType?: 'programs';
}
// MDX pages render this layout via `layout:` frontmatter, so their YAML lands
// under Astro.props.frontmatter. Fall back to Astro.props for direct rendering.
const { title, subtitle, sections, description, ogImage, schemaType } =
  Astro.props.frontmatter ?? Astro.props;
const pageSections = Array.isArray(sections) ? sections : [];

// ---- SEO ----
// Every page needs its own description: eleven pages sharing one string is a
// duplicate-description problem, and search engines tend to discard them.
const SITE_NAME = "Dr. Jiang 'John' Li";
const DEFAULT_DESCRIPTION =
  'Program Chair for Analytics Programs at Franklin University | Data Science Educator | Former Industry Data Scientist';
const metaDescription = description ?? DEFAULT_DESCRIPTION;
// `Astro.site` comes from astro.config.mjs; `Astro.url.pathname` already carries
// the `preserve` build format, so canonical URLs match what is actually served.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(ogImage ?? '/img/og-default.png', Astro.site).href;
const pageTitle = title ?? SITE_NAME;

// Person schema on every page; the two degrees get their own schema on Programs.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: "Jiang 'John' Li",
  honorificPrefix: 'Dr.',
  jobTitle: 'Program Chair, Analytics Programs',
  worksFor: { '@type': 'CollegeOrUniversity', name: 'Franklin University' },
  url: new URL('/', Astro.site).href,
  image: new URL('/img/jiang.jpg', Astro.site).href,
  email: 'mailto:jiang.li2@franklin.edu',
  sameAs: ['https://www.linkedin.com/in/jiang-li-analytics/'],
  knowsAbout: ['Business Analytics', 'Data Analytics', 'Machine Learning', 'Learning Analytics'],
};

// Credit hours and focus-area counts come from Franklin's Kuali catalogue.
const programSchemas =
  schemaType === 'programs'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'EducationalOccupationalProgram',
          name: 'B.S. in Analytics',
          educationalCredentialAwarded: 'Bachelor of Science',
          programType: 'Undergraduate degree',
          numberOfCredits: 120,
          educationalProgramMode: 'online',
          occupationalCategory: ['Data Analyst', 'BI Analyst', 'Data Engineer', 'Statistician'],
          provider: { '@type': 'CollegeOrUniversity', name: 'Franklin University' },
          url: new URL('/program.html#bs-analytics', Astro.site).href,
        },
        {
          '@context': 'https://schema.org',
          '@type': 'EducationalOccupationalProgram',
          name: 'M.S. in Business Analytics',
          educationalCredentialAwarded: 'Master of Science',
          programType: 'Graduate degree',
          numberOfCredits: 32,
          timeToComplete: 'P12M',
          educationalProgramMode: 'online',
          occupationalCategory: ['Management Analyst', 'Analytics Consultant', 'Data Scientist'],
          provider: { '@type': 'CollegeOrUniversity', name: 'Franklin University' },
          url: new URL('/program.html#ms-business-analytics', Astro.site).href,
        },
      ]
    : [];
// `variant` is passed by the wrapping layout, not by MDX frontmatter.
const { variant } = Astro.props;
const isGuide = variant === 'guide';

// "Career Outcomes", not "Careers": on a university site "Careers" reads as
// job vacancies — we are hiring — rather than where a degree leads. It sits in
// the nav because that question is the one prospective students arrive with.
// Courses stays out; it is a catalog, reached from Programs.
const navLinks = [
  { text: 'Home', href: '/index.html' },
  { text: 'Programs', href: '/program.html' },
  { text: 'Career Outcomes', href: '/careers.html' },
  { text: 'Teaching', href: '/teach.html' },
  { text: 'Research', href: '/publication.html' },
  { text: 'Posts', href: '/post.html' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Jiang 'John' Li" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>

    <!-- Open Graph / Twitter. Without these a shared link renders bare on
         LinkedIn, which is where most of this site's traffic is referred from. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — Program Chair, Analytics Programs, Franklin University`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={shareImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {programSchemas.map((sc) => (
      <script type="application/ld+json" set:html={JSON.stringify(sc)} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z48603M6WF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-Z48603M6WF');
    </script>
    <!-- Pagefind search UI assets (generated at build time into /pagefind/) -->
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </head>
  <body>
    <header class="site-navbar">
      <nav class="navbar-inner">
        <button class="nav-toggle" aria-label="Toggle navigation" onclick="document.getElementById('navMenu').classList.toggle('open')"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/></svg></button>
        <div class="nav-links" id="navMenu">
          {
            navLinks.map((l) => (
              <a href={l.href} class="nav-link">
                {l.text}
              </a>
            ))
          }
        </div>
        <div class="nav-right">
          <button class="nav-icon-btn" aria-label="Search" onclick="document.getElementById('searchPanel').classList.toggle('open');document.querySelector('#searchPanel input')?.focus()"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg></button>
          <a class="nav-icon-btn" aria-label="LinkedIn" href="https://www.linkedin.com/in/jiang-li-analytics/">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
          <a class="nav-icon-btn" aria-label="Email" href="mailto:jiang.li2@franklin.edu">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
        </div>
      </nav>
      <div class="search-panel" id="searchPanel">
        <!-- Pagefind 1.5.2 Component UI: `pagefind-searchbox` is the self-contained
             input + results dropdown. `shortcut="none"` keeps the component from
             binding a global Ctrl/Cmd+K; the search button above is the only entry point. -->
        <pagefind-searchbox id="search" placeholder="Search..." shortcut="none" hide-shortcut
        ></pagefind-searchbox>
      </div>
    </header>

    {
      isGuide ? (
        <div class="guide-shell">
          <slot name="sidebar" />
          <main class="page-main guide-main" id="guide-main">
            {title && <h1 class="title">{title}</h1>}
            {subtitle && <p class="subtitle lead">{subtitle}</p>}
            <slot name="content-top" />
            <slot />
            <slot name="content-bottom" />
          </main>
        </div>
      ) : (
        <main class="page-main">
          {title && <h1 class="title">{title}</h1>}
          {subtitle && <p class="subtitle lead">{subtitle}</p>}
          {pageSections.length > 0 && (
            <nav class="page-toc" aria-label="On this page" data-pagefind-ignore>
              <ul>
                {pageSections.map((s) => (
                  <li>
                    <a href={`#${s.id}`} data-toc-target={s.id}>
                      {s.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <slot />
        </main>
      )
    }

    <footer class="page-footer">
      <div class="footer-inner">
        <div class="footer-col">Dr. Jiang Li | Franklin University</div>
        <div class="footer-col footer-center">
          <a href="mailto:jiang.li2@franklin.edu"><svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg> jiang.li2@franklin.edu</a>
          |
          <a href="https://outlook.office.com/bookwithme/user/1b87d6117e28448bbaa0cb30b44c1f47@franklin.edu?anonymous&ep=bwmEmailSignature"><svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/></svg> Book Meeting</a>
        </div>
        <div class="footer-col footer-right">© {new Date().getFullYear()}</div>
      </div>
    </footer>

    <!-- Scroll-spy for the in-page section nav (.page-toc), used by Programs and
         Careers. Rendered unconditionally and guarded in JS: wrapping a script in
         an Astro `{cond && (...)}` block emits the JSX braces as literal text and
         the script never parses. -->
    <script is:inline>
      (function () {
        var links = [].slice.call(document.querySelectorAll('.page-toc a[data-toc-target]'));
        if (!links.length) return;
        var targets = links
          .map(function (a) { return document.getElementById(a.getAttribute('data-toc-target')); })
          .filter(Boolean);
        if (!targets.length) return;

        function setActive(id) {
          links.forEach(function (a) {
            var on = a.getAttribute('data-toc-target') === id;
            a.classList.toggle('is-active', on);
            if (on) { a.setAttribute('aria-current', 'true'); }
            else { a.removeAttribute('aria-current'); }
          });
        }

        function navH() {
          var n = document.querySelector('.site-navbar');
          var t = document.querySelector('.page-toc');
          return (n ? n.offsetHeight : 0) + (t ? t.offsetHeight : 0) + 8;
        }

        function current() {
          // Sit the spy line a little below the sticky bars. scroll-margin-top
          // lands a clicked heading just under them, and a line flush with the
          // bars would then score that heading as "not reached yet" and keep the
          // previous chip lit.
          var line = navH() + 28;
          var atEnd = window.innerHeight + window.scrollY >= document.body.offsetHeight - 2;
          var best = targets[0];
          for (var i = 0; i < targets.length; i++) {
            var top = targets[i].getBoundingClientRect().top;
            if (top <= line) best = targets[i];
            // The last section can be too short to reach the spy line, so at the
            // very bottom take the last heading that is on screen at all.
            if (atEnd && top <= window.innerHeight) best = targets[i];
          }
          return best.id;
        }

        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            setActive(current());
            ticking = false;
          });
        }

        function setOffset() {
          var n = document.querySelector('.site-navbar');
          document.documentElement.style.setProperty('--toc-sticky-top', (n ? n.offsetHeight : 56) + 'px');
          document.documentElement.style.setProperty('--page-toc-offset', navH() + 'px');
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', function () { setOffset(); onScroll(); }, { passive: true });
        links.forEach(function (a) {
          a.addEventListener('click', function () { setActive(a.getAttribute('data-toc-target')); });
        });
        setOffset();
        setActive(current());
      })();
    </script>
  </body>
</html>
